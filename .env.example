# THREADKEEP Environment Configuration
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/threadkeep
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Optional Gemini API Key (If omitted, THREADKEEP's Deep Intelligence Engine runs in zero-config mode)
GEMINI_API_KEY=your_gemini_api_key_here
